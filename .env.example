# Google Gemini API Key - Replace with your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Server & Model Configuration
PORT=3000
GEMINI_MODEL=gemini-flash-latest

# Optional Authentication Provider (Supabase Auth)
# Create a free project at https://supabase.com to enable real accounts
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your-supabase-anon-public-key
